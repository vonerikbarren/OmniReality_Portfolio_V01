{
  "schema": "omni-sound-design/1",
  "title": "OmniOS sound design list (primitives)",
  "status": "DRAFT for the owner to approve or cut. Nothing here is wired to the app yet; only ui.click, ui.open and ui.close exist today.",
  "classes": {
    "1": "Ambience / field (continuous texture: where am I)",
    "2": "Earcons (small fixed vocabulary, one sound = one meaning, hard ceiling of a few dozen)",
    "3": "Event SFX / stingers (feedback about an action; a few reusable archetypes)",
    "4": "Entity signatures (the same earcon voiced in the same timbre every time an entity is involved; not a separate set)"
  },
  "shapeRules": [
    "rising pitch = begin / yes / success",
    "falling pitch = end / no / failure",
    "flat = neutral or confirm",
    "one note = simple event, two = exchange, three or more = sequence",
    "a sound must be tellable from the others without looking at the screen"
  ],
  "rules": [
    "fire sounds on state changes, never every frame",
    "repeatable sounds stay under about 150 ms",
    "every sound has a role: semantic or decorative; decorative ones must not drift into meaning slots",
    "each volumeGroup gets its own level (ui and time are much quieter than feedback)",
    "keep the whole set under about 30 entries",
    "a sound is bound to exactly one meaning and is never reused"
  ],
  "volumeGroups": [
    "ui",
    "feedback",
    "time",
    "ambience"
  ],
  "roles": [
    "semantic",
    "decorative"
  ],
  "rate": {
    "rare": "a few times a minute at most",
    "frequent": "can fire many times a minute: keep very short and quiet"
  },
  "groups": [
    "basic",
    "result",
    "nodes",
    "lines",
    "movement",
    "time",
    "truth"
  ],
  "entries": [
